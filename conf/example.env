# ============================================================
# 交付配置模板
# 用法：cp conf/example.env conf/<主机名>.env 后按实际情况修改
# 注意：conf/*.env 已在 .gitignore 中排除，不要把真实配置提交到仓库
# ============================================================

# ---------- 基础 ----------
# 主机名，建议统一命名规范，如 prod-<项目>-<用途><序号>
HOSTNAME=prod-epf-node31

# 时区
TIMEZONE=Asia/Shanghai

# ---------- 网络 ----------
# 网卡名，用 `ip -br link` 确认，常见 eno1 / ens33 / enp3s0
MGMT_IFACE=eno1

# 管理 IP 与掩码前缀长度（24 对应 255.255.255.0）
MGMT_IP=10.10.20.31
MGMT_PREFIX_LEN=24

GATEWAY=10.10.20.1

# 多个 DNS 用英文逗号分隔
DNS_SERVERS=10.10.0.10,223.5.5.5

# 1 = 写入后立即 netplan apply；0 = 只生成配置，人工确认后手动 apply
# 首次通过远程改网络时建议设为 0
NETPLAN_APPLY=1

# VLAN 号，无需 VLAN 则留空
VLAN_ID=

# ---------- 数据盘 ----------
# 用 `lsblk -f` 确认设备名，注意不要写系统盘
# 建议使用分区（如 /dev/sdb1）而非整盘，便于后续扩容
DATA_DEVICE=/dev/sdb1
# 交付规范约定的挂载点；港口现场惯例是 /media/ai/disk，按项目要求改
DATA_MOUNT=/data
DATA_FSTYPE=ext4

# 1 = 允许格式化（会清空该设备全部数据），默认 0 表示只挂载不格式化
DATA_ALLOW_FORMAT=0

# ---------- 交付制品（步骤 35） ----------
# 制品 zip 的绝对路径，一般就在数据盘根目录
DEPLOY_ZIP=${DATA_MOUNT}/deploy_files.zip
# 解压落点（必须是已挂载的数据盘，脚本会强校验）
DEPLOY_DEST=${DATA_MOUNT}
# 数据盘挂载点，用于「是否已挂载」的强校验；留空则取 DATA_MOUNT
DEPLOY_MOUNT=${DATA_MOUNT}
# zip 内顶层目录名，解压后应为 ${DEPLOY_DEST}/deploy_files
DEPLOY_SUBDIR=deploy_files

# zip 口令。留空则走 unzip 交互式输入（更安全，口令不进进程列表）
DEPLOY_ZIP_PASS=

# 1 = 单盘工控机无独立数据盘时整步跳过（按现场规范）
DEPLOY_SKIP=0
# 1 = 已解压过也强制重新解压（默认 0，靠标记文件判断幂等）
DEPLOY_FORCE_EXTRACT=0
# 解压后最少文件数，低于此值视为包不完整
DEPLOY_MIN_FILES=1
# 解压后必须存在的关键路径，空格分隔，相对 DEPLOY_SUBDIR
DEPLOY_VERIFY_PATHS=

# ---------- FTP 增量同步（步骤 35，紧跟解压） ----------
# 留空 FTP_HOST 则跳过同步
FTP_HOST=
FTP_USER=
FTP_PASS=
# 远端目录（以远端为准往下拉）
FTP_REMOTE_DIR=/data/deploy/deploy_files
# 本地目录，留空默认取解压出来的目录
FTP_LOCAL_DIR=
# 并发数，链路差就降到 1~2
FTP_PARALLEL=4
# 同步完成后本地最少文件数，留空不校验
FTP_MIN_FILES=

# ---------- 内核与驱动锁定（步骤 70） ----------
# 留空 = 自动锁定当前运行内核的 image/headers/modules + 相关元包
KERNEL_HOLD_PACKAGES=
# 1 = 同时关闭 apt 周期自动升级（只锁内核拦不住其它包的自动升级与重启）
KERNEL_DISABLE_AUTO_UPGRADE=1

# ---------- 软件源与依赖 ----------
# 内网镜像源地址；留空表示不修改现有源
APT_MIRROR=http://10.10.0.30/ubuntu

# 内网 NTP 服务器，多个用空格分隔
NTP_SERVERS=10.10.0.20

# 额外需要安装的包，空格分隔
EXTRA_PACKAGES=

# ---------- VNC ----------
VNC_USER=ops
# 必填，至少 8 位；请勿提交到仓库
VNC_PASSWORD=
VNC_GEOMETRY=1920x1080
VNC_DISPLAY=1

# ---------- frp ----------
FRP_SERVER_ADDR=10.10.40.5
FRP_SERVER_PORT=7000
FRP_TOKEN=
# 服务端映射端口，需在服务端放行且仅允许跳板机访问
FRP_REMOTE_PORT=15901
# 本地转发端口，配合 VNC 时为 5900+display
FRP_LOCAL_PORT=5901
