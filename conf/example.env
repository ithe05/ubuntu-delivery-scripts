# ============================================================
# 交付配置模板
# 用法：cp conf/example.env conf/<主机名>.env 后按实际情况修改
# 注意：conf/*.env 已在 .gitignore 中排除，不要把真实配置提交到仓库
# ============================================================

# ---------- 基础 ----------
# 主机名，建议统一命名规范，如 prod-<项目>-<用途><序号>
HOSTNAME=prod-epf-node31

# 时区
TIMEZONE=Asia/Shanghai

# ---------- 网络 ----------
# 网卡名，用 `ip -br link` 确认，常见 eno1 / ens33 / enp3s0
MGMT_IFACE=eno1

# 管理 IP 与掩码前缀长度（24 对应 255.255.255.0）
MGMT_IP=10.10.20.31
MGMT_PREFIX_LEN=24

GATEWAY=10.10.20.1

# 多个 DNS 用英文逗号分隔
DNS_SERVERS=10.10.0.10,223.5.5.5

# 1 = 写入后立即 netplan apply；0 = 只生成配置，人工确认后手动 apply
# 首次通过远程改网络时建议设为 0
NETPLAN_APPLY=1

# VLAN 号，无需 VLAN 则留空
VLAN_ID=

# ---------- 数据盘 ----------
# 用 `lsblk -f` 确认设备名，注意不要写系统盘
# 建议使用分区（如 /dev/sdb1）而非整盘，便于后续扩容
DATA_DEVICE=/dev/sdb1
DATA_MOUNT=/data
DATA_FSTYPE=ext4

# 1 = 允许格式化（会清空该设备全部数据），默认 0 表示只挂载不格式化
DATA_ALLOW_FORMAT=0

# ---------- 软件源与依赖 ----------
# 内网镜像源地址；留空表示不修改现有源
APT_MIRROR=http://10.10.0.30/ubuntu

# 内网 NTP 服务器，多个用空格分隔
NTP_SERVERS=10.10.0.20

# 额外需要安装的包，空格分隔
EXTRA_PACKAGES=

# ---------- VNC ----------
VNC_USER=ops
# 必填，至少 8 位；请勿提交到仓库
VNC_PASSWORD=
VNC_GEOMETRY=1920x1080
VNC_DISPLAY=1

# ---------- frp ----------
FRP_SERVER_ADDR=10.10.40.5
FRP_SERVER_PORT=7000
FRP_TOKEN=
# 服务端映射端口，需在服务端放行且仅允许跳板机访问
FRP_REMOTE_PORT=15901
# 本地转发端口，配合 VNC 时为 5900+display
FRP_LOCAL_PORT=5901
